APP_ENV=development
PORT=8080
DATABASE_URL=postgres://lit:lit@localhost:54329/lit?sslmode=disable
CORS_ORIGINS=http://localhost:5173
# dev: acepta tokens "dev:<uid>:<email>" (sólo local). firebase: verifica ID tokens.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Chat con IA del glosario (console.groq.com). Sin clave, la app anda igual y el
# chat no aparece. GROQ_MODEL es opcional: el catálogo de Groq cambia seguido.
GROQ_API_KEY=
GROQ_MODEL=

# Quién puede darse de alta, separados por coma. Vacío en desarrollo significa
# que cualquiera entra; vacío en producción, que no se aceptan altas nuevas (los
# que ya tienen cuenta siguen entrando).
ALLOWED_EMAILS=

# Topes diarios de lo que se le paga al proveedor de IA. Los "per user" son por
# persona; los "global", el techo de la app entera, que es lo que protege una
# clave compartida. Cero desactiva el tope.
ASK_DAILY_PER_USER=60
ASK_DAILY_GLOBAL=600
SPEAKING_DAILY_PER_USER=40
SPEAKING_DAILY_GLOBAL=400

# Distinciones en la cadena (docs/sdd-distinciones.md §6). Sin las cuatro, la
# funcionalidad no existe: los endpoints contestan 503, /healthz dice
# "chain": false y la pantalla no muestra nada de esto. La app anda igual.
#
# CHAIN_ID: 84532 es Base Sepolia, 8453 Base, 31337 anvil local.
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_CONTRACT=

# La clave que firma los vouchers. NUNCA se escribe acá ni en ningún .env
# commiteado: vive sólo como variable de entorno en producción. No tiene fondos
# —no puede gastar, sólo firmar— y el contrato tiene setFirmante para rotarla
# sin volver a desplegar. Aun así, si se filtra se pueden falsificar
# distinciones, así que se trata como el secreto más serio del proyecto.
CHAIN_SIGNER_KEY=
