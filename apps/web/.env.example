# API en Go. Local: docker compose + go run ./cmd/api (puerto 8080).
PUBLIC_API_URL=http://localhost:8080

# Firebase Authentication (consola de Firebase → Configuración del proyecto → Tus apps).
# Si quedan vacías, en `pnpm dev` aparece el login falso de desarrollo.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
