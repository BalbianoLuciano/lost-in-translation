# Copiá esto a `contracts/.env` —que está gitignoreado— y completalo.
# Acá no va NINGUNA clave privada: la que manda la transacción se pasa en la
# línea de comandos (`--interactive`, `--ledger`, `--trezor`), y la del firmante
# vive sólo en Railway. De este archivo sale la dirección pública, nada más.

# Quien puede rotar el firmante. Idealmente una billetera de hardware.
DUENIO=0x0000000000000000000000000000000000000000

# La dirección pública de la clave con la que el servidor firma los vouchers.
FIRMANTE=0x0000000000000000000000000000000000000000

# El catálogo. Por defecto, script/catalogo.json.
# CATALOGO=script/catalogo.json

# Base Sepolia (chain id 84532).
RPC_URL=https://sepolia.base.org

# Sólo para verificar el código en sepolia.basescan.org.
BASESCAN_API_KEY=
